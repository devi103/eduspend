# EduSpend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Supabase Configuration (public/anon key only — safe for frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

# NOTE: The service_role key must NEVER be used in frontend code.
# It should only be used in secure server-side environments.
